# ============ Osiris ============
NODE_ENV="production" # Node.js environment mode
PORT="3000" # HTTP port the Next.js server listens on
HOSTNAME="0.0.0.0" # Bind interface for the Next.js standalone server

# ============ Optional API Integrations ============
# All API keys below are optional. Osiris is designed to work out-of-the-box
# without any credentials — these only enhance specific data sources.

OPENSKY_USERNAME="" # Optional OpenSky Network username for enhanced flight tracking quotas
OPENSKY_PASSWORD="" # Optional OpenSky Network password paired with OPENSKY_USERNAME
N2YO_API_KEY="" # Optional N2YO API key for satellite tracking (get one at n2yo.com)
AIS_API_KEY="" # Optional AIS Stream API key for live maritime vessel tracking
SCANNER_URL="" # Optional external port scanner service URL for the RECON toolkit
SCANNER_KEY="" # Optional auth key paired with SCANNER_URL
